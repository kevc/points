-- The append-only event ledger. Rows are never updated (except an idempotent re-insert of the same id
-- during sync) and never hard-deleted; a "reset" is a compensating delta row, and deleting a point type
-- is a tombstone elsewhere. The current value of a type is SUM(delta) over its rows.
--
-- Every row is scoped to an owner_id (the tenancy/partition key from local_state). The local ledger holds
-- a single owner today, but scoping every query by owner keeps the schema correct when an owner is rebound
-- to an account (M6) and mirrors the server, where one ledger holds many owners.
--
-- `pending` is 1 for a locally-created event not yet confirmed by the backend, 0 once sync has pushed it
-- (and for every event pulled down from the server). It is the push half of sync's two watermarks; the
-- server `seq` cursor (in local_state) is the pull half.

CREATE TABLE point_event (
    id            TEXT    NOT NULL PRIMARY KEY,
    owner_id      TEXT    NOT NULL,
    point_type_id TEXT    NOT NULL,
    delta         INTEGER NOT NULL,
    device_id     TEXT    NOT NULL,
    created_at    INTEGER NOT NULL,
    pending       INTEGER NOT NULL DEFAULT 0
);

CREATE INDEX point_event_by_owner_type ON point_event(owner_id, point_type_id);

-- Idempotent upsert by client-generated id: re-receiving an event during sync is a no-op union. `pending`
-- is set by the caller — 1 for a local append, 0 for an event applied from the server.
upsert:
INSERT OR REPLACE INTO point_event(id, owner_id, point_type_id, delta, device_id, created_at, pending)
VALUES (?, ?, ?, ?, ?, ?, ?);

-- Current value for an owner's type. COALESCE makes an empty ledger evaluate to 0 (one row, never null).
valueForType:
SELECT COALESCE(SUM(delta), 0) FROM point_event WHERE owner_id = ? AND point_type_id = ?;

eventsForType:
SELECT * FROM point_event WHERE owner_id = ? AND point_type_id = ? ORDER BY created_at, id;

-- All of an owner's per-type aggregates in one grouped scan — the home grid's single value read, collapsing
-- what was a SUM query (and, for an easing tile, a recency query) per type into one reactive query so a
-- write re-emits once, not once per observed type (the N+1). Per row:
--   total            = SUM(delta) all-time (a cumulative tile's value)
--   today_total      = SUM(delta) at/after :since, the daily "today" window (caller passes local midnight;
--                      pass 0 to fold today into all-time)
--   last_positive_at = MAX(created_at) over *positive* events, the recency input for an easing gauge; COALESCE
--                      to 0 keeps it a non-null Long (the data source maps 0 — no positive event, impossible
--                      for a real epoch-millis timestamp — back to null)
-- A type with no rows is simply absent; the caller defaults it to zero (PointAggregate.Empty).
aggregates:
SELECT point_type_id,
       COALESCE(SUM(delta), 0) AS total,
       COALESCE(SUM(CASE WHEN created_at >= :since THEN delta ELSE 0 END), 0) AS today_total,
       COALESCE(MAX(CASE WHEN delta > 0 THEN created_at ELSE NULL END), 0) AS last_positive_at
FROM point_event
WHERE owner_id = :owner
GROUP BY point_type_id;

-- The owner's events awaiting upload — sync's push set.
pendingEvents:
SELECT * FROM point_event WHERE owner_id = ? AND pending = 1 ORDER BY created_at, id;

-- Count of the owner's pending events. Reactive: drives the sync indicator so local edits that haven't
-- reached the server (e.g. an unreachable backend while the OS network is up) are reflected, not masked
-- behind a stale "Synced".
pendingCount:
SELECT COUNT(*) FROM point_event WHERE owner_id = ? AND pending = 1;

-- Mark events confirmed by the backend (after a successful sync push).
clearPending:
UPDATE point_event SET pending = 0 WHERE owner_id = ? AND id IN ?;
